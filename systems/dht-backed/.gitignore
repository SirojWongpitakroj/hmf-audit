# Private key material must never be committed (Q46, Q47).
#   producer private keys:  <producer-id>.key   (producer/keys.go)
#   CA private key:         ca.sk               (auth, benchmark/harness.go)
# Public keys (*.pub, ca.pk) are deliberately NOT ignored: they are safe to commit.
*.key
*.sk

# Hardhat build output, regenerated by `npx hardhat compile`. The contract
# binding the Go code actually uses lives in blockchain/binding/ and is tracked.
artifacts/
cache/

# Node dependencies, restored by `npm install`.
node_modules/

# Local integration-run logs.
.localrun/

# Personal Claude Code overrides; the shared project settings stay tracked.
.claude/settings.local.json
