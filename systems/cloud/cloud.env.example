# Copy to cloud.env (git-ignored) and fill in the INTERNAL (VPC) IP addresses.
# Read by experiments/scripts/lib.sh when FAIR_CLOUD=1, and by the provisioning
# scripts in provision/.

# --- Cassandra: one VM per scheme (t2a-standard-2), one keyspace each ---------
CLOUD_HMF_CASSANDRA_HOST=      # VM 1: keyspace hmf_audit (the four regions R0..R3 are partitions inside it)
CLOUD_EVSEB_CASSANDRA_HOST=    # VM 2: keyspace evseb     (dht_entries + routing_table)
CLOUD_DHT_CASSANDRA_HOST=      # VM 3: keyspace dhtbacked (proof_entries + routing_table)
CLOUD_CASSANDRA_PORT=9042

# --- PostgreSQL ----------------------------------------------------------------
CLOUD_BLAS_PG_HOST=            # VM 4: schema blas
CLOUD_SHARED_PG_HOST=          # VM 5: schemas hmf, evseb, dht (cloud-provider storage)
CLOUD_PG_PORT=5432
CLOUD_PG_USER=fair
CLOUD_PG_DB=fair_benchmark
CLOUD_PG_PASSWORD=             # 12+ letters/digits only; no default on purpose

# --- Blockchain anchor (VM 7, e2-medium) -----------------------------------------
CLOUD_ANCHOR_HOST=
CLOUD_ANCHOR_PORT=8545

# --- Database VM tuning (used by provision/*.sh; identical on every VM of a kind)
# Cassandra heap on an 8 GiB VM. Local Docker uses 2G; leave room for page cache.
CLOUD_CASSANDRA_HEAP=3G
CLOUD_CASSANDRA_NEWSIZE=600M
# Where the persistent data disk is mounted on a database VM.
FAIR_DATA_DIR=/var/lib/fair-data
